   340	/* Animations */
   341	@keyframes fadeIn {
   342	    from {
   343	        opacity: 0;
   344	        transform: translateY(20px);
   345	    }
   346	    to {
   347	        opacity: 1;
   348	        transform: translateY(0);
   349	    }
   350	}
   351	
   352	.fade-in {
   353	    animation: fadeIn 0.5s ease-out;
   354	}
   355	
   356	@keyframes pulse {
   357	    0%, 100% {
   358	        opacity: 1;
   359	    }
   360	    50% {
   361	        opacity: 0.5;
   362	    }
   363	}
   364	
   365	.pulse {
   366	    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
   367	}
   368	
   369	/* Print Styles */
   370	@media print {
   371	    .no-print {
   372	        display: none !important;
   373	    }
   374	    
   375	    body {
   376	        background: white;
   377	    }
   378	    
   379	    .bg-gradient-to-br {
   380	        background: white !important;
   381	    }
   382	}
   383	
   384	/* Scrollbar Styling */
   385	::-webkit-scrollbar {
   386	    width: 10px;
   387	}
   388	
   389	::-webkit-scrollbar-track {
   390	    background: #f1f1f1;
   391	}
   392	
   393	::-webkit-scrollbar-thumb {
   394	    background: #888;
   395	    border-radius: 5px;
   396	}
   397	
   398	::-webkit-scrollbar-thumb:hover {
   399	    background: #555;
   400	}
   401	
   402	/* Loading Spinner */
   403	.spinner {
   404	    border: 4px solid #f3f3f3;
   405	    border-top: 4px solid #3b82f6;
   406	    border-radius: 50%;
   407	    width: 40px;
   408	    height: 40px;
   409	    animation: spin 1s linear infinite;
   410	}
   411	
   412	@keyframes spin {
   413	    0% { transform: rotate(0deg); }
   414	    100% { transform: rotate(360deg); }
   415	}
   416	
   417	/* Tooltip */
   418	.tooltip {
   419	    position: relative;
   420	    display: inline-block;
   421	}
   422	
   423	.tooltip .tooltiptext {
   424	    visibility: hidden;
   425	    width: 200px;
   426	    background-color: #1f2937;
   427	    color: white;
   428	    text-align: center;
   429	    border-radius: 6px;
   430	    padding: 8px;
   431	    position: absolute;
   432	    z-index: 1;
   433	    bottom: 125%;
   434	    left: 50%;
   435	    margin-left: -100px;
   436	    opacity: 0;
   437	    transition: opacity 0.3s;
   438	    font-size: 0.875rem;
   439	}
   440	
   441	.tooltip:hover .tooltiptext {
   442	    visibility: visible;
   443	    opacity: 1;
   444	}
   445	
   446	/* Success Animation */
   447	@keyframes checkmark {
   448	    0% {
   449	        stroke-dashoffset: 100;
   450	    }
   451	    100% {
   452	        stroke-dashoffset: 0;
   453	    }
   454	}
   455	
   456	.checkmark {
   457	    animation: checkmark 0.5s ease-in-out;
   458	}
   459	
   460	/* Card Hover Effect */
   461	.card-hover {
   462	    transition: all 0.3s ease;
   463	}
   464	
   465	.card-hover:hover {
   466	    transform: translateY(-5px) scale(1.02);
   467	    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
   468	}
