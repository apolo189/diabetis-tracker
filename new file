function exportToCSV() {
    const data = DataManager.getAllTrackingData();
    
    if (data.length === 0) {
        showNotification('No hay datos para exportar', 'error');
        return;
    }

    // CSV header
    let csv = 'Fecha,Peso (lbs),Glucosa Ayunas (mg/dL),Glucosa Post-Comida (mg/dL),Dolor (0-10),Sueño (hrs),Sentadillas,Notas\n';
    
    // CSV rows
    data.forEach(entry => {
        csv += `${entry.date},${entry.weight},${entry.glucoseFasting},${entry.glucosePostMeal},${entry.painLevel},${entry.sleepHours},${entry.squats},"${entry.notes || ''}"\n`;
    });

    // Create download
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    
    link.setAttribute('href', url);
    link.setAttribute('download', `diabetes-tracking-${new Date().toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    showNotification('✅ Datos exportados a CSV');
